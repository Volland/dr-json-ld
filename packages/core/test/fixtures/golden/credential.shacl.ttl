@prefix cred: <https://example.org/credentials#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cred:CredentialShape
  a sh:NodeShape ;
  sh:targetClass cred:VerifiableCredential ;
  sh:description "Every credential names who issued it, when it becomes valid, and whom it is about." ;
  sh:property [
    sh:path cred:credentialSubject ;
    sh:minCount 1 ;
    sh:node cred:DegreeSubjectShape
  ] ;
  sh:property [
    sh:path cred:evidence ;
    sh:class cred:DocumentVerification
  ] ;
  sh:property [
    sh:path cred:issuer ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI
  ] ;
  sh:property [
    sh:path cred:validFrom ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:dateTime
  ] .

cred:DegreeShape
  a sh:NodeShape ;
  sh:targetClass cred:UniversityDegree ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path schema:name ;
    sh:minCount 1 ;
    sh:maxCount 1
  ] .

cred:DegreeSubjectShape
  a sh:NodeShape ;
  sh:property [
    sh:path cred:degree ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node cred:DegreeShape
  ] ;
  sh:property [
    sh:path schema:name ;
    sh:maxCount 1 ;
    sh:datatype xsd:string
  ] .
